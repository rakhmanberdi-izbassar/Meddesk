# Local development only. `make env` creates .env with a random URL-safe password.
# Never commit .env. Production needs HTTPS, backups and separate DB privileges.
APP_ENV=development
POSTGRES_USER=meddesk
POSTGRES_DB=meddesk
POSTGRES_PASSWORD=
# Keep manually supplied credentials URL-safe: letters, digits, underscore/hyphen.
# Compose services use internal DNS; host Go development uses DATABASE_URL below.
DATABASE_URL=
# Optional multiline public CA PEM for a private PostgreSQL certificate; requires verify-full.
DATABASE_CA_CERT=
GATEWAY_PORT=8080
HTTP_ADDR=:8081
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s
MEDIA_DIR=/var/lib/meddesk/media
MEDIA_UPLOAD_TIMEOUT=2m
MEDIA_STREAM_TIMEOUT=5m
# Default video limit 100 MiB (database permits up to 500 MiB); images 10 MiB.
MEDIA_MAX_VIDEO_BYTES=104857600
# Exact frontend origins for login and CSRF validation, no wildcard CORS.
AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL=8h
COOKIE_SECURE=false
# Empty means ignore forwarded IP headers; set only actual trusted proxy CIDRs.
TRUSTED_PROXY_CIDRS=
# Development-only account seed; `make demo-env` generates passwords privately.
DEMO_EMPLOYEE_PASSWORD=
DEMO_ENGINEER_PASSWORD=
DEMO_ADMIN_PASSWORD=
